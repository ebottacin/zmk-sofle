        rgb_layer0_off: rgb_layer0_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &rgb_ug RGB_OFF>;
        };

        rgb_caps_white: rgb_caps_white {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &rgb_ug RGB_ON>, <&macro_tap &rgb_ug RGB_SOLID>, <&macro_tap &rgb_ug RGB_COLOR_HSB(0,0,100)>;
        };

        rgb_layer1: rgb_layer1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &rgb_ug RGB_ON>, <&macro_tap &rgb_ug RGB_SOLID>, <&macro_tap &rgb_ug RGB_COLOR_HSB(220,100,70)>;
        };

        rgb_layer2: rgb_layer2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &rgb_ug RGB_ON>, <&macro_tap &rgb_ug RGB_SOLID>, <&macro_tap &rgb_ug RGB_COLOR_HSB(120,100,70)>;
        };

        rgb_layer3: rgb_layer3 {
